<?xml version="1.0" encoding="utf-8"?>
<Configuration>
    <ViewDefinitions>
        <View>
            <Name>ConfluenceRestrictionTable</Name>
            <ViewSelectedBy>
                <TypeName>ConfluenceRestriction</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Operation</Label></TableColumnHeader>
                    <TableColumnHeader><Label>RestrictionsUserCount</Label></TableColumnHeader>
                    <TableColumnHeader><Label>RestrictionsGroupCount</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>Operation</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>RestrictionsUserCount</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>RestrictionsGroupCount</PropertyName></TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
    </ViewDefinitions>
</Configuration>
